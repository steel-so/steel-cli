{
  "openapi": "3.1.0",
  "info": {
    "title": "Steel API v1 (contract fixture)",
    "version": "0.0.0-fixture",
    "description": "Hand-written fixture shaped after docs/cli/README.md of the Steel repo. Used to generate the SDK until the app publishes public/openapi.v1.json. Only the routes cli-core consumes are described."
  },
  "servers": [{ "url": "https://homologacao.stratustelecom.com.br" }],
  "security": [{ "personalToken": [] }],
  "paths": {
    "/api/v1/auth/device": {
      "post": {
        "operationId": "startDeviceAuthorization",
        "summary": "Start the CLI device login",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/DeviceAuthorizationRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Device code issued",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/DeviceAuthorization" } }
                    }
                  ]
                }
              }
            }
          },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/auth/device/token": {
      "post": {
        "operationId": "pollDeviceToken",
        "summary": "Exchange an approved device code for a personal token",
        "tags": ["Auth"],
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["deviceCode"],
                "properties": { "deviceCode": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Approved: the personal token (returned only once)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/DeviceToken" } }
                    }
                  ]
                }
              }
            }
          },
          "403": { "$ref": "#/components/responses/Error" },
          "410": { "$ref": "#/components/responses/Error" },
          "428": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "getMe",
        "summary": "The user, workspace and token behind the current personal token",
        "tags": ["Me"],
        "responses": {
          "200": {
            "description": "Current identity",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/Me" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/events": {
      "get": {
        "operationId": "listWebhookEvents",
        "summary": "Catalog of the webhook events Steel sends",
        "tags": ["Webhooks"],
        "responses": {
          "200": {
            "description": "Event catalog (only the token's modules)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookEventType" } } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/endpoints": {
      "get": {
        "operationId": "listWebhookEndpoints",
        "summary": "Webhook endpoints of the workspace (OWNER/ADMIN)",
        "tags": ["Webhooks"],
        "responses": {
          "200": {
            "description": "Endpoints",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookEndpointPage" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      },
      "post": {
        "operationId": "createWebhookEndpoint",
        "summary": "Register a webhook endpoint (api:write)",
        "tags": ["Webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateWebhookEndpointRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Endpoint and its signing secret (returned only here)",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookEndpointWithSecret" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/endpoints/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "patch": {
        "operationId": "updateWebhookEndpoint",
        "summary": "Change a webhook endpoint (api:write)",
        "tags": ["Webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateWebhookEndpointRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Endpoint",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookEndpoint" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      },
      "delete": {
        "operationId": "deleteWebhookEndpoint",
        "summary": "Remove a webhook endpoint (api:write)",
        "tags": ["Webhooks"],
        "responses": {
          "200": {
            "description": "Removed",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": {
                        "data": { "type": "object", "required": ["id"], "properties": { "id": { "type": "string" } } }
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/endpoints/{id}/test": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": {
        "operationId": "testWebhookEndpoint",
        "summary": "Send a steel.ping to one endpoint now (api:write)",
        "tags": ["Webhooks"],
        "responses": {
          "200": {
            "description": "The test delivery",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookDelivery" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/deliveries": {
      "get": {
        "operationId": "listWebhookDeliveries",
        "summary": "Delivery log, newest first (30-day retention)",
        "tags": ["Webhooks"],
        "parameters": [
          { "name": "endpointId", "in": "query", "required": false, "schema": { "type": "string" } },
          { "name": "status", "in": "query", "required": false, "schema": { "$ref": "#/components/schemas/WebhookDeliveryStatus" } },
          { "name": "limit", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "cursor", "in": "query", "required": false, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "A page of deliveries",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookDeliveryPage" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/deliveries/{id}/retry": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "post": {
        "operationId": "retryWebhookDelivery",
        "summary": "Queue one more attempt of a delivery (api:write)",
        "tags": ["Webhooks"],
        "responses": {
          "202": {
            "description": "Retry queued",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookDelivery" } }
                    }
                  ]
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/listen": {
      "get": {
        "operationId": "listenWebhooks",
        "summary": "Server-Sent Events with the workspace's webhook events (steel listen)",
        "description": "First `event: ready` with WebhookListenReady, then `event: webhook` (id = event id) with WebhookListenFrame for each event, and a `: ping` comment every 25 s.",
        "tags": ["Webhooks"],
        "parameters": [
          { "name": "events", "in": "query", "required": false, "description": "Comma-separated event types; empty means all", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": { "text/event-stream": { "schema": { "type": "string" } } }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "429": { "$ref": "#/components/responses/Error" }
        }
      }
    },
    "/api/v1/webhooks/trigger": {
      "post": {
        "operationId": "triggerWebhookEvent",
        "summary": "Create a test event of a catalog type (steel trigger, api:write)",
        "tags": ["Webhooks"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TriggerWebhookEventRequest" }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Event created",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    { "$ref": "#/components/schemas/SuccessEnvelope" },
                    {
                      "type": "object",
                      "required": ["data"],
                      "properties": { "data": { "$ref": "#/components/schemas/WebhookTriggerResult" } }
                    }
                  ]
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Error" },
          "401": { "$ref": "#/components/responses/Error" },
          "403": { "$ref": "#/components/responses/Error" },
          "404": { "$ref": "#/components/responses/Error" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "personalToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Personal API token (stl_pat_...)"
      }
    },
    "responses": {
      "Error": {
        "description": "Error envelope",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorEnvelope" }
          }
        }
      }
    },
    "schemas": {
      "SuccessEnvelope": {
        "type": "object",
        "required": ["success", "statusCode"],
        "properties": {
          "success": { "type": "boolean", "const": true },
          "statusCode": { "type": "integer" },
          "message": { "type": "string" }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": ["success", "statusCode", "error"],
        "properties": {
          "success": { "type": "boolean", "const": false },
          "statusCode": { "type": "integer" },
          "message": { "type": "string" },
          "error": {
            "type": "object",
            "required": ["code"],
            "properties": {
              "code": { "type": "string" },
              "details": {}
            }
          }
        }
      },
      "ApiScope": { "type": "string", "enum": ["api:read", "api:write"] },
      "ModuleKind": {
        "type": "string",
        "enum": ["SERVICE_DESK", "CRM", "COMMUNICATION"]
      },
      "WorkspaceRef": {
        "type": "object",
        "required": ["id", "slug", "name"],
        "properties": {
          "id": { "type": "string" },
          "slug": { "type": "string" },
          "name": { "type": "string" }
        }
      },
      "DeviceAuthorizationRequest": {
        "type": "object",
        "properties": {
          "clientName": { "type": "string", "maxLength": 80 },
          "deviceName": { "type": "string", "maxLength": 120 }
        }
      },
      "DeviceAuthorization": {
        "type": "object",
        "required": [
          "deviceCode",
          "userCode",
          "verificationUri",
          "verificationUriComplete",
          "interval",
          "expiresIn"
        ],
        "properties": {
          "deviceCode": { "type": "string" },
          "userCode": { "type": "string" },
          "verificationUri": { "type": "string", "format": "uri" },
          "verificationUriComplete": { "type": "string", "format": "uri" },
          "interval": { "type": "integer", "description": "Seconds between polls" },
          "expiresIn": { "type": "integer", "description": "Seconds until the device code expires" }
        }
      },
      "DeviceToken": {
        "type": "object",
        "required": ["token", "tokenId", "expiresAt", "workspace", "scopes", "modules"],
        "properties": {
          "token": { "type": "string", "pattern": "^stl_pat_" },
          "tokenId": { "type": "string" },
          "expiresAt": { "type": "string", "format": "date-time" },
          "workspace": { "$ref": "#/components/schemas/WorkspaceRef" },
          "scopes": { "type": "array", "items": { "$ref": "#/components/schemas/ApiScope" } },
          "modules": { "type": "array", "items": { "$ref": "#/components/schemas/ModuleKind" } }
        }
      },
      "Me": {
        "type": "object",
        "required": ["user", "workspace", "scopes", "modules", "token"],
        "properties": {
          "user": {
            "type": "object",
            "required": ["id", "name", "email"],
            "properties": {
              "id": { "type": "string" },
              "name": { "type": "string" },
              "email": { "type": "string", "format": "email" }
            }
          },
          "workspace": { "$ref": "#/components/schemas/WorkspaceRef" },
          "scopes": { "type": "array", "items": { "$ref": "#/components/schemas/ApiScope" } },
          "modules": { "type": "array", "items": { "$ref": "#/components/schemas/ModuleKind" } },
          "token": {
            "type": "object",
            "required": ["id", "expiresAt"],
            "properties": {
              "id": { "type": "string" },
              "expiresAt": { "type": "string", "format": "date-time" }
            }
          }
        }
      },
      "WebhookEventModule": {
        "type": "string",
        "enum": ["SERVICE_DESK", "CRM", "COMMUNICATION", "AGENTS", "PLATFORM"]
      },
      "WebhookEventType": {
        "type": "object",
        "required": ["type", "module", "description", "subscribable"],
        "properties": {
          "type": { "type": "string", "example": "crm.lead.created" },
          "module": { "$ref": "#/components/schemas/WebhookEventModule" },
          "description": { "type": "string", "description": "pt-BR" },
          "subscribable": { "type": "boolean", "description": "false only for steel.ping" }
        }
      },
      "WebhookEndpoint": {
        "type": "object",
        "required": [
          "id",
          "workspaceId",
          "url",
          "description",
          "events",
          "active",
          "secretHint",
          "disabledAt",
          "disabledReason",
          "failingSince",
          "lastSuccessAt",
          "lastFailureAt",
          "createdById",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "workspaceId": { "type": "string" },
          "url": { "type": "string" },
          "description": { "type": ["string", "null"] },
          "events": { "type": "array", "items": { "type": "string" }, "description": "Catalog types, or [\"*\"] for all" },
          "active": { "type": "boolean" },
          "secretHint": { "type": "string", "example": "whsec_…a1b2" },
          "disabledAt": { "type": ["string", "null"], "format": "date-time" },
          "disabledReason": { "type": ["string", "null"], "description": "manual or auto" },
          "failingSince": { "type": ["string", "null"], "format": "date-time" },
          "lastSuccessAt": { "type": ["string", "null"], "format": "date-time" },
          "lastFailureAt": { "type": ["string", "null"], "format": "date-time" },
          "createdById": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time" }
        }
      },
      "WebhookEndpointPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookEndpoint" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "WebhookEndpointWithSecret": {
        "type": "object",
        "required": ["endpoint", "secret"],
        "properties": {
          "endpoint": { "$ref": "#/components/schemas/WebhookEndpoint" },
          "secret": { "type": "string", "pattern": "^whsec_" }
        }
      },
      "CreateWebhookEndpointRequest": {
        "type": "object",
        "required": ["url", "events"],
        "properties": {
          "url": { "type": "string", "maxLength": 2048 },
          "description": { "type": "string", "maxLength": 200 },
          "events": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "active": { "type": "boolean" }
        }
      },
      "UpdateWebhookEndpointRequest": {
        "type": "object",
        "properties": {
          "url": { "type": "string", "maxLength": 2048 },
          "description": { "type": ["string", "null"], "maxLength": 200 },
          "events": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "active": { "type": "boolean" }
        }
      },
      "WebhookDeliveryStatus": {
        "type": "string",
        "enum": ["PENDING", "SUCCEEDED", "RETRYING", "FAILED", "SKIPPED"]
      },
      "WebhookDelivery": {
        "type": "object",
        "required": [
          "id",
          "endpointId",
          "eventId",
          "eventType",
          "status",
          "attempts",
          "responseStatus",
          "responseBody",
          "durationMs",
          "error",
          "requestBody",
          "lastAttemptAt",
          "deliveredAt",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string" },
          "endpointId": { "type": "string" },
          "eventId": { "type": "string" },
          "eventType": { "type": "string" },
          "status": { "$ref": "#/components/schemas/WebhookDeliveryStatus" },
          "attempts": { "type": "integer" },
          "responseStatus": { "type": ["integer", "null"] },
          "responseBody": { "type": ["string", "null"], "description": "First 1 KB of the answer" },
          "durationMs": { "type": ["integer", "null"] },
          "error": { "type": ["string", "null"], "example": "http_500" },
          "requestBody": { "type": "string", "description": "Exact JSON body sent" },
          "lastAttemptAt": { "type": ["string", "null"], "format": "date-time" },
          "deliveredAt": { "type": ["string", "null"], "format": "date-time" },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      },
      "WebhookDeliveryPage": {
        "type": "object",
        "required": ["items", "nextCursor"],
        "properties": {
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/WebhookDelivery" } },
          "nextCursor": { "type": ["string", "null"] }
        }
      },
      "TriggerWebhookEventRequest": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "type": "string" },
          "endpointId": { "type": "string" }
        }
      },
      "WebhookTriggerResult": {
        "type": "object",
        "required": ["event", "deliveries"],
        "properties": {
          "event": {
            "type": "object",
            "required": ["id", "type"],
            "properties": { "id": { "type": "string" }, "type": { "type": "string" } }
          },
          "deliveries": { "type": "integer", "description": "Endpoint deliveries queued (0 when only listeners get it)" }
        }
      },
      "WebhookEvent": {
        "type": "object",
        "description": "Body of every webhook delivery",
        "required": ["id", "type", "createdAt", "workspaceId", "data"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "createdAt": { "type": "string", "format": "date-time" },
          "workspaceId": { "type": "string" },
          "data": {}
        }
      },
      "WebhookListenReady": {
        "type": "object",
        "description": "Data of the first SSE message (event: ready) of /api/v1/webhooks/listen",
        "required": ["workspaceId", "events", "secret"],
        "properties": {
          "workspaceId": { "type": "string" },
          "events": { "type": "array", "items": { "type": "string" }, "description": "Filter in effect; empty means all" },
          "secret": { "type": "string", "description": "Signing secret of this member's listen feed" }
        }
      },
      "WebhookListenFrame": {
        "type": "object",
        "description": "Data of each SSE message (event: webhook): the exact body and the three Steel-Webhook-* header values",
        "required": ["id", "timestamp", "signature", "body"],
        "properties": {
          "id": { "type": "string" },
          "timestamp": { "type": "integer", "description": "Unix seconds (Steel-Webhook-Timestamp)" },
          "signature": { "type": "string", "description": "Steel-Signature header value (v1=<hex>)" },
          "body": { "type": "string", "description": "Exact JSON body of the event" }
        }
      }
    }
  }
}
